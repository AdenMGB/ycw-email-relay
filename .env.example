# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_PATH=./database

# SMTP Configuration (for local Postfix or SMTP relay)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# SendGrid Configuration (optional - takes priority over SMTP)
# Get your API key from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Mailgun Configuration (optional)
# Get your API key from https://app.mailgun.com/app/account/security/api_keys
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# AWS SES Configuration (optional)
# Get your credentials from AWS IAM Console
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1

# Security
# Generate secure random strings for production:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production-use-random-string
API_KEY_SECRET=change-me-in-production-use-random-string

# Email Defaults
DEFAULT_FROM_EMAIL=noreply@ycwadelaide.adenmgb.com
DEFAULT_FROM_NAME=YCW Adelaide

# Rate Limiting
DEFAULT_RATE_LIMIT=1000

# CORS
# Set to specific domain(s) in production, e.g., https://ycwadelaide.adenmgb.com
# Use * for development only
CORS_ORIGIN=*
